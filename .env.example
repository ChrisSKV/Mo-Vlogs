# CRM inbound webhook that triggers the sales dial. Until set, leads are only
# written to Neon and logged server-side.
CRM_WEBHOOK_URL=

# Neon connection string.
DATABASE_URL=

# Public company/legal names used in consent + rules copy.
NEXT_PUBLIC_COMPANY_NAME="The Build Challenge"
NEXT_PUBLIC_LEGAL_ENTITY="{LEGAL_ENTITY_NAME}"
NEXT_PUBLIC_SUPPORT_EMAIL="support@example.com"

# Flips the thank-you page + confirmation copy from email-only to SMS/WhatsApp
# once sender-ID registration clears. Multi-week regulatory process — see spec.
NEXT_PUBLIC_MESSAGING_CHANNEL=email
